      "id": "0d7953c2-ffe3-4da9-92c0-fd7ad278ed3d",
      "name": "Get SEC Submissions"
    },
    {
      "parameters": {
        "jsCode": "const secResponse = $input.first().json;\nconst settings = $('Company Settings').first().json;\n\nconst recent =\n  secResponse.filings &&\n  secResponse.filings.recent;\n\nif (!recent || !Array.isArray(recent.form)) {\n  throw new Error(\n    'The SEC response does not contain filings.recent data.'\n  );\n}\n\nconst requestedForm = String(\n  settings.form_type || '10-K'\n);\n\nconst maxFilings = Number(\n  settings.max_filings || 1\n);\n\nconst cikPadded = String(\n  settings.cik\n).padStart(10, '0');\n\nconst numericCik = parseInt(\n  cikPadded,\n  10\n);\n\nif (!Number.isFinite(numericCik)) {\n  throw new Error(\n    'The company CIK is not valid.'\n  );\n}\n\nconst cikWithoutLeadingZeros =\n  String(numericCik);\n\nconst matchingFilings = [];\n\nfor (\n  let i = 0;\n  i < recent.form.length;\n  i++\n) {\n  if (recent.form[i] !== requestedForm) {\n    continue;\n  }\n\n  const accessionNumber = String(\n    recent.accessionNumber[i] || ''\n  ).trim();\n\n  const primaryDocument = String(\n    recent.primaryDocument[i] || ''\n  ).trim();\n\n  if (\n    accessionNumber === '' ||\n    primaryDocument === ''\n  ) {\n    continue;\n  }\n\n  const accessionWithoutDashes =\n    accessionNumber\n      .split('-')\n      .join('');\n\n  const ticker = String(\n    settings.ticker\n  ).toUpperCase();\n\n  const sourceUrl =\n    'https://www.sec.gov/Archives/edgar/data/' +\n    cikWithoutLeadingZeros +\n    '/' +\n    accessionWithoutDashes +\n    '/' +\n    primaryDocument;\n\n  matchingFilings.push({\n    ticker: ticker,\n    company_name: secResponse.name,\n    cik: cikPadded,\n    form_type: recent.form[i],\n    filing_date: recent.filingDate[i],\n    report_date: recent.reportDate[i],\n    accession_number: accessionNumber,\n    primary_document: primaryDocument,\n    source_url: sourceUrl,\n    document_id:\n      ticker +\n      '_' +\n      recent.form[i] +\n      '_' +\n      accessionWithoutDashes\n  });\n}\n\nmatchingFilings.sort(\n  (first, second) =>\n    Date.parse(second.filing_date) -\n    Date.parse(first.filing_date)\n);\n\nif (matchingFilings.length === 0) {\n  throw new Error(\n    'No ' +\n    requestedForm +\n    ' filing was found for ' +\n    settings.ticker +\n    '.'\n  );\n}\n\nreturn matchingFilings\n  .slice(0, maxFilings)\n  .map((filing) => {\n    return {\n      json: filing\n    };\n  });"
      },
