      "id": "ab3b4e65-ad40-42b7-b144-3314bd0ed4bb",
      "name": "Extract Filing Text"
    },
    {
      "parameters": {
        "jsCode": "const extracted = $input.first().json;\nconst filing = $('Select Latest 10-K').first().json;\n\nlet text = String(\n  extracted.filing_text || ''\n);\n\n// Replace non-breaking spaces and remove carriage returns.\ntext = text\n  .split('\\u00A0')\n  .join(' ')\n  .split('\\r')\n  .join('');\n\nconst cleanedLines = [];\nlet previousLineWasBlank = false;\n\nfor (const rawLine of text.split('\\n')) {\n  const cleanedLine = rawLine\n    .split('\\t')\n    .join(' ')\n    .split(' ')\n    .filter((part) => part !== '')\n    .join(' ')\n    .trim();\n\n  if (cleanedLine === '') {\n    if (!previousLineWasBlank) {\n      cleanedLines.push('');\n    }\n\n    previousLineWasBlank = true;\n  } else {\n    cleanedLines.push(cleanedLine);\n    previousLineWasBlank = false;\n  }\n}\n\ntext = cleanedLines\n  .join('\\n')\n  .trim();\n\nif (text.length < 10000) {\n  throw new Error(\n    'The extracted filing text is unexpectedly short: ' +\n    text.length +\n    ' characters.'\n  );\n}\n\nreturn [\n  {\n    json: {\n      ...filing,\n      text: text,\n      character_count: text.length,\n      section: 'full-filing-baseline'\n    }\n  }\n];"
      },
